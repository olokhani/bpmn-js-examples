<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             targetNamespace="http://bpmn.io/schema/bpmn">
  <process id="homeLabProcess" isExecutable="true">

    <!-- Lanes -->
    <laneSet id="laneSet_1">
      <lane id="lane_ops" name="Operations"/>
      <lane id="lane_sampler" name="Sampler"/>
      <lane id="lane_lab" name="Laboratory"/>
      <lane id="lane_doctor" name="Interpretation Doctor"/>
    </laneSet>

    <!-- Start -->
    <startEvent id="StartEvent" name="Order Received"/>

    <!-- Operations: Assign Sampler -->
    <task id="AssignSampler" name="Assign Sampler"/>
    
    <!-- Sampler: Perform Sampling -->
    <task id="PerformSampling" name="Perform Sampling"/>
    
    <!-- Lab: Receive Samples -->
    <task id="ReceiveSamples" name="Receive Samples at Lab"/>
    
    <!-- Lab: Upload Results -->
    <task id="UploadResults" name="Upload Test Results"/>
    
    <!-- Operations: Send to Customer -->
    <task id="SendToCustomer" name="Send Results to Customer"/>
    
    <!-- Operations: Assign Interpretation Doctor -->
    <task id="AssignDoctor" name="Assign Doctor"/>
    
    <!-- Doctor: Call & Interpret -->
    <task id="Interpretation" name="Doctor Interpretation Call"/>
    
    <!-- End -->
    <endEvent id="EndEvent" name="Order Closed"/>

    <!-- Sequence Flows -->
    <sequenceFlow id="flow1" sourceRef="StartEvent" targetRef="AssignSampler"/>
    <sequenceFlow id="flow2" sourceRef="AssignSampler" targetRef="PerformSampling"/>
    <sequenceFlow id="flow3" sourceRef="PerformSampling" targetRef="ReceiveSamples"/>
    <sequenceFlow id="flow4" sourceRef="ReceiveSamples" targetRef="UploadResults"/>
    <sequenceFlow id="flow5" sourceRef="UploadResults" targetRef="SendToCustomer"/>
    <sequenceFlow id="flow6" sourceRef="SendToCustomer" targetRef="AssignDoctor"/>
    <sequenceFlow id="flow7" sourceRef="AssignDoctor" targetRef="Interpretation"/>
    <sequenceFlow id="flow8" sourceRef="Interpretation" targetRef="EndEvent"/>

  </process>
</definitions>
